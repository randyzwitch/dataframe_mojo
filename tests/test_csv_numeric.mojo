def test_direct_float64_strict_syntax_and_specials() raises:
    for text in ["", ".", "+", "1x", "1e", "1e+", " 1", "1 ", "1.2.3"]:
        var failed = False
        try:
            _ = parse_csv_float64(StringSlice(text))
        except:
            failed = True
        assert_equal(failed, True, msg=text)
    _assert_bits64("-0.0", UInt64(0x8000000000000000))
    _assert_bits64("INF", UInt64(0x7FF0000000000000))
    _assert_bits64("+NaN", UInt64(0x7FF8000000000000))
    _assert_bits64("-nAn", UInt64(0xFFF8000000000000))
    _assert_bits64("-Infinity", UInt64(0xFFF0000000000000))
    for text in ["infinityx", "nanx"]:
        var failed = False
        try:
            _ = parse_csv_float64(StringSlice(text))
        except:
            failed = True
        assert_equal(failed, True, msg=text)


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
