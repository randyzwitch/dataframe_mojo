def test_direct_float32_strict_syntax_and_specials() raises:
    for text in ["", ".", "+", "1x", "1e", "1e+", " 1", "1 ", "1.2.3"]:
        var failed = False
        try:
            _ = parse_csv_float32(StringSlice(text))
        except:
            failed = True
        assert_equal(failed, True, msg=text)
    _assert_bits("-0.0", UInt32(0x80000000))
    _assert_bits("INF", UInt32(0x7F800000))
    _assert_bits("+NaN", UInt32(0x7FC00000))
    _assert_bits("-nAn", UInt32(0xFFC00000))
    _assert_bits("-Infinity", UInt32(0xFF800000))
    for text in ["infinityx", "nanx"]:
        var failed = False
        try:
            _ = parse_csv_float32(StringSlice(text))
        except:
            failed = True
        assert_equal(failed, True, msg=text)


def _assert_bits64(text: String, expected: UInt64) raises:
    assert_equal(
        bitcast[DType.uint64](parse_csv_float64(StringSlice(text))),
        expected,
        msg=text,
    )


