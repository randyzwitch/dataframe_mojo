"""Generated Polars 1.44.2 Float32 parser bit fixtures."""
from std.memory import bitcast
from std.testing import TestSuite, assert_equal

from dataframe.csv_numeric import parse_csv_float32, parse_csv_float64


def _assert_bits(text: String, expected: UInt32) raises:
    assert_equal(
        bitcast[DType.uint32](parse_csv_float32(StringSlice(text))),
        expected,
        msg=text,
    )


def test_direct_float32_matches_polars_oracle_bits() raises:
    _assert_bits("0", UInt32(0x00000000))
    _assert_bits("-0", UInt32(0x80000000))
    _assert_bits("0.0", UInt32(0x00000000))
    _assert_bits("-0.0", UInt32(0x80000000))
    _assert_bits("1.25", UInt32(0x3FA00000))
    _assert_bits("-1.25", UInt32(0xBFA00000))
    _assert_bits("1e-46", UInt32(0x00000000))
    # Above the exact Float32 midpoint: a Float64-then-cast path can differ.
    _assert_bits("1.000000059604644775390625000001", UInt32(0x3F800001))
    _assert_bits("1e-45", UInt32(0x00000001))
