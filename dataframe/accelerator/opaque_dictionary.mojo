"""Isolated opaque-byte transport domain; no public backend enablement.

Only generated ASCII hex keys enter String/sorted vectors. Binary/Geometry payloads are
read as bounded raw spans and restored as byte buffers, never decoded as UTF8.
The caller reserves construction, encoding and restoration before allocation.
"""
from dataframe import Column, DataType, Series, StringColumn
from dataframe.partition import _hash_bytes
from dataframe.accelerator.memory import checked_add, checked_mul


def hex_key(data: Span[UInt8, ImmutAnyOrigin]) raises -> String:
    var bytes = List[UInt8](capacity=checked_mul(len(data), 2))
    for value in data:
        var high = value >> 4
        var low = value & 15
        bytes.append(UInt8(48) + high if high < 10 else UInt8(87) + high)
        bytes.append(UInt8(48) + low if low < 10 else UInt8(87) + low)
    # Every generated byte is ASCII0..9/a..f; arbitrary source bytes never
    # enter an unsafe UTF8 constructor. Move the generated owning buffer.
    return String(unsafe_from_utf8=bytes)


def hex_key(data: String) raises -> String:
    # The borrowed String owns this span for the entire conversion call.
    var bytes = data.as_bytes()
    return hex_key(
        Span[UInt8, ImmutAnyOrigin](
            unsafe_ptr=bytes.unsafe_ptr()
            .unsafe_mut_cast[False]()
            .unsafe_origin_cast[ImmutAnyOrigin](),
            length=len(bytes),
        )
    )


def _nibble(value: UInt8) raises -> UInt8:
    if value >= 48 and value <= 57:
        return value - 48
    if value >= 97 and value <= 102:
        return value - 87
    raise Error("Opaque transport key is not canonical lowercase hex")


def raw_key(key: String) raises -> List[UInt8]:
    var text = key.as_bytes()
    if len(text) & 1:
        raise Error("Opaque transport key has odd length")
    var bytes = List[UInt8](capacity=len(text) // 2)
    for at in range(0, len(text), 2):
        bytes.append((_nibble(text[at]) << 4) | _nibble(text[at + 1]))
    return bytes^


struct ByteDomain(Movable):
    """Raw byte domain after original typed-schema validation; codes order bytes.

    Numeric codes never replace logical validation: callers must bind the
    complete original query before staging any mixed Binary/Geometry columns.
    """

    var keys: List[String]
    var bytes: List[UInt8]
    var offsets: List[Int64]
    var hashes: List[UInt64]

    def __init__(
        out self, columns: List[Series], literals: List[String] = List[String]()
    ) raises:
        var capacity = len(literals)
        var payload = 0
        for column in columns:
            if not column.dtype()._is_bytes():
                raise Error("Opaque transport requires Binary or Geometry")
            capacity = checked_add(capacity, len(column))
            for part in column.chunks():
                ref values = part._data[StringColumn]
                for row in range(len(part)):
                    if values._valid(row):
                        payload = checked_add(
                            payload, len(values._row_bytes(row))
                        )
        for literal in literals:
            payload = checked_add(payload, literal.byte_length())
        if capacity > Int(UInt32.MAX):
            raise Error("Opaque transport exceeds UInt32 entry reservation")
        self.keys = List[String](capacity=capacity)
        self.bytes = List[UInt8](capacity=payload)
        self.offsets = List[Int64](capacity=checked_add(capacity, 1))
        self.hashes = List[UInt64](capacity=capacity)
        for column in columns:
            if not column.dtype()._is_bytes():
                raise Error("Opaque transport requires Binary or Geometry")
            for part in column.chunks():
                ref values = part._data[StringColumn]
                for row in range(len(part)):
                    if values._valid(row):
                        self.keys.append(hex_key(values._row_bytes(row)))
        for literal in literals:
            self.keys.append(hex_key(literal))
        sort(self.keys)
        var unique = List[String](capacity=len(self.keys))
        for key in self.keys:
            if not len(unique) or key != unique[len(unique) - 1]:
                unique.append(key.copy())
        self.keys = unique^
        self.offsets.append(0)
        for code in range(len(self.keys)):
            var raw = raw_key(self.keys[code])
            _ = checked_add(len(self.bytes), len(raw))
            self.hashes.append(_hash_bytes(Span[UInt8, ImmutAnyOrigin](raw)))
            self.bytes.extend(raw^)
            self.offsets.append(Int64(len(self.bytes)))

    def code(self, data: Span[UInt8, ImmutAnyOrigin]) raises -> UInt32:
        var key = hex_key(data)
        var low = 0
        var high = len(self.keys)
        while low < high:
            var middle = low + (high - low) // 2
            if self.keys[middle] < key:
                low = middle + 1
            else:
                high = middle
        if low >= len(self.keys) or self.keys[low] != key:
            raise Error("Opaque transport source value is outside dictionary")
        return UInt32(low)

    def code(self, data: String) raises -> UInt32:
        # Keep the String borrow alive while looking up its raw UTF8 bytes.
        var bytes = data.as_bytes()
        return self.code(
            Span[UInt8, ImmutAnyOrigin](
                unsafe_ptr=bytes.unsafe_ptr()
                .unsafe_mut_cast[False]()
                .unsafe_origin_cast[ImmutAnyOrigin](),
                length=len(bytes),
            )
        )

    def encode(self, column: Series) raises -> Series:
        if not column.dtype()._is_bytes():
            raise Error("Opaque transport requires Binary or Geometry")
        var codes = List[UInt32](length=len(column), fill=0)
        var valid = List[Bool](length=len(column), fill=False)
        var at = 0
        for part in column.chunks():
            ref values = part._data[StringColumn]
            for row in range(len(part)):
                if values._valid(row):
                    codes[at] = self.code(values._row_bytes(row))
                    valid[at] = True
                at += 1
        var result = Series(column.name(), Column[UInt32](codes^, valid))
        result._field_metadata = column._field_metadata
        return result^

    def restore(self, codes: Series, prototype: Series) raises -> Series:
        if (
            codes.dtype() != DataType.UINT32
            or not prototype.dtype()._is_bytes()
        ):
            raise Error("Opaque transport output schema differs")
        var rows = List[List[UInt8]](capacity=len(codes))
        var valid = List[Bool](capacity=len(codes))
        for part in codes.chunks():
            ref values = part._data[Column[UInt32]]
            for row in range(len(part)):
                var present = values._valid(row)
                var raw = List[UInt8]()
                if present:
                    var code = Int(values._get(row))
                    if code >= len(self.keys):
                        raise Error(
                            "Opaque transport result code is outside dictionary"
                        )
                    var start = Int(self.offsets[code])
                    var end = Int(self.offsets[code + 1])
                    raw.extend(Span(self.bytes)[start:end])
                rows.append(raw^)
                valid.append(present)
        var result = Series.binary(codes.name(), rows, valid).with_dtype(
            prototype.dtype()
        )
        result._field_metadata = prototype._field_metadata
        return result^
