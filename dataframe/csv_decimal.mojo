@fieldwise_init
struct CsvDecimal(Copyable):
    var num_digits: Int
    var decimal_point: Int
    var negative: Bool
    var truncated: Bool
    var digits: Array[UInt8, CSV_DECIMAL_MAX_DIGITS]

    def __init__(out self):
        self.num_digits = 0
        self.decimal_point = 0
        self.negative = False
        self.truncated = False
        self.digits = Array[UInt8, CSV_DECIMAL_MAX_DIGITS](fill=0)

    def try_add_digit(mut self, digit: UInt8):
        if self.num_digits < CSV_DECIMAL_MAX_DIGITS:
            self.digits[self.num_digits] = digit
        self.num_digits += 1

    def trim(mut self):
        while self.num_digits != 0 and self.digits[self.num_digits - 1] == 0:
            self.num_digits -= 1

    def round(self) -> UInt64:
        if self.num_digits == 0 or self.decimal_point < 0:
            return 0
        if self.decimal_point > 18:
            return UInt64(0xFFFFFFFFFFFFFFFF)
        var value = UInt64(0)
        for i in range(self.decimal_point):
            value *= 10
            if i < self.num_digits:
                value += UInt64(self.digits[i])
        var round_up = False
        if self.decimal_point < self.num_digits:
            var next = self.digits[self.decimal_point]
            round_up = next >= 5
            if next == 5 and self.decimal_point + 1 == self.num_digits:
                round_up = self.truncated or (
                    self.decimal_point != 0
                    and (self.digits[self.decimal_point - 1] & 1) != 0
                )
        if round_up:
            value += 1
        return value

    def left_shift(mut self, shift: Int):
        if self.num_digits == 0:
            return
        var actual_shift = shift & 63
        var new_digits = _number_of_digits_decimal_left_shift(
            self, actual_shift
        )
        var read_index = self.num_digits
        var write_index = self.num_digits + new_digits
        var accumulator = UInt64(0)
        while read_index != 0:
            read_index -= 1
            write_index -= 1
            accumulator += UInt64(self.digits[read_index]) << UInt64(
                actual_shift
            )
            var quotient = accumulator // 10
            var remainder = accumulator - 10 * quotient
            if write_index < CSV_DECIMAL_MAX_DIGITS:
                self.digits[write_index] = UInt8(remainder)
            elif remainder > 0:
                self.truncated = True
            accumulator = quotient
        while accumulator > 0:
            write_index -= 1
            var quotient = accumulator // 10
            var remainder = accumulator - 10 * quotient
            if write_index < CSV_DECIMAL_MAX_DIGITS:
                self.digits[write_index] = UInt8(remainder)
            elif remainder > 0:
                self.truncated = True
            accumulator = quotient
        self.num_digits += new_digits
        if self.num_digits > CSV_DECIMAL_MAX_DIGITS:
            self.num_digits = CSV_DECIMAL_MAX_DIGITS
        self.decimal_point += new_digits
        self.trim()

    def right_shift(mut self, shift: Int):
        var actual_shift = shift & 63
        var read_index = 0
        var write_index = 0
        var accumulator = UInt64(0)
        while (accumulator >> UInt64(actual_shift)) == 0:
            if read_index < self.num_digits:
                accumulator = 10 * accumulator + UInt64(self.digits[read_index])
                read_index += 1
            elif accumulator == 0:
                return
            else:
                while (accumulator >> UInt64(actual_shift)) == 0:
                    accumulator *= 10
                    read_index += 1
                break
        self.decimal_point -= read_index - 1
        if self.decimal_point < -CSV_DECIMAL_POINT_RANGE:
            self.num_digits = 0
            self.decimal_point = 0
            self.negative = False
            self.truncated = False
            return
        var mask = (UInt64(1) << UInt64(actual_shift)) - 1
        while read_index < self.num_digits:
            var new_digit = UInt8(accumulator >> UInt64(actual_shift))
            accumulator = 10 * (accumulator & mask) + UInt64(
                self.digits[read_index]
            )
            read_index += 1
            self.digits[write_index] = new_digit
            write_index += 1
        while accumulator > 0:
            var new_digit = UInt8(accumulator >> UInt64(actual_shift))
            accumulator = 10 * (accumulator & mask)
            if write_index < CSV_DECIMAL_MAX_DIGITS:
                self.digits[write_index] = new_digit
                write_index += 1
            elif new_digit > 0:
                self.truncated = True
        self.num_digits = write_index
        self.trim()


def _number_of_digits_decimal_left_shift(d: CsvDecimal, shift: Int) -> Int:
    var actual_shift = shift & 63
    var table = materialize[_LEFT_SHIFT_TABLE]()
    var pow5 = materialize[_LEFT_SHIFT_POW5]()
    var a = table[actual_shift]
    var b = table[actual_shift + 1]
    var new_digits = Int(a >> 11)
    var pow5_start = Int(a & UInt16(0x07FF))
    var pow5_end = Int(b & UInt16(0x07FF))
    for i in range(pow5_end - pow5_start):
        if i >= d.num_digits:
            return new_digits - 1
        if d.digits[i] < pow5[pow5_start + i]:
            return new_digits - 1
        if d.digits[i] > pow5[pow5_start + i]:
            return new_digits
    return new_digits


def parse_csv_decimal(text: StringSlice) raises -> CsvDecimal:
    """Direct scalar translation of fast-float2 decimal.rs::parse_decimal."""
    var bytes = text.as_bytes()
    if len(bytes) == 0:
        raise Error("empty decimal")
    var result = CsvDecimal()
    var start = 0
    result.negative = bytes[0] == 45
    if bytes[0] == 45 or bytes[0] == 43:
        start = 1
    if start >= len(bytes):
        raise Error("decimal sign without digits")

    var cursor = start
    while cursor < len(bytes) and bytes[cursor] == 48:
        cursor += 1
    while cursor < len(bytes) and bytes[cursor] >= 48 and bytes[cursor] <= 57:
        result.try_add_digit(bytes[cursor] - 48)
        cursor += 1
    if cursor < len(bytes) and bytes[cursor] == 46:
        cursor += 1
        var fractional_start = cursor
        if result.num_digits == 0:
            while cursor < len(bytes) and bytes[cursor] == 48:
                cursor += 1
        while (
            cursor < len(bytes) and bytes[cursor] >= 48 and bytes[cursor] <= 57
        ):
            result.try_add_digit(bytes[cursor] - 48)
            cursor += 1
        result.decimal_point = fractional_start - cursor

    if result.num_digits != 0:
        var trailing = 0
        var reverse = cursor
        while reverse > start:
            reverse -= 1
            if bytes[reverse] == 48:
                trailing += 1
            elif bytes[reverse] != 46:
                break
        result.decimal_point += trailing
        result.num_digits -= trailing
        result.decimal_point += result.num_digits
        if result.num_digits > CSV_DECIMAL_MAX_DIGITS:
            result.truncated = True
            result.num_digits = CSV_DECIMAL_MAX_DIGITS

    if cursor < len(bytes) and (bytes[cursor] == 101 or bytes[cursor] == 69):
        cursor += 1
        var negative_exponent = False
        if cursor < len(bytes) and bytes[cursor] == 45:
            negative_exponent = True
            cursor += 1
        elif cursor < len(bytes) and bytes[cursor] == 43:
            cursor += 1
        var exponent = 0
        while (
            cursor < len(bytes) and bytes[cursor] >= 48 and bytes[cursor] <= 57
        ):
            if exponent < 0x10000:
                exponent = 10 * exponent + Int(bytes[cursor] - 48)
            cursor += 1
        result.decimal_point += -exponent if negative_exponent else exponent
    if cursor != len(bytes):
        raise Error("invalid decimal byte")
    for i in range(result.num_digits, min(CSV_DECIMAL_MAX_DIGITS, 19)):
        result.digits[i] = 0
    return result^
