+struct ChunkedFrame(Copyable, Sized):
+    """Experimental zero-copy vertical frame made of ordinary DataFrames.
+
+    Each chunk keeps the independent buffers produced by a parallel CSV range.
+    The cumulative offsets map global row positions to an owning frame. This
+    deliberately wraps existing Series storage rather than changing Column,
+    so it measures the benefit and cost of deferred reassembly in isolation.
+    """
+
+    var _chunks: List[DataFrame]
+    var _ends: List[Int]
+    var _height: Int
+
+    def __init__(out self, var chunks: List[DataFrame]) raises:
+        if len(chunks) == 0:
+            raise Error("ChunkedFrame requires at least one chunk")
+        var first = chunks[0].schema()
+        var ends = List[Int](capacity=len(chunks))
+        var height = 0
+        for i in range(len(chunks)):
+            var schema = chunks[i].schema()
+            if len(schema) != len(first):
+                raise Error("ChunkedFrame chunks have different widths")
+            for c in range(len(first)):
+                if (
+                    schema[c].name != first[c].name
+                    or schema[c].dtype != first[c].dtype
+                ):
+                    raise Error("ChunkedFrame chunks have different schemas")
+            height += chunks[i].height()
+            ends.append(height)
+        self._chunks = chunks^
+        self._ends = ends^
+        self._height = height
+
+    def __len__(self) -> Int:
+        return self._height
+
+    def height(self) -> Int:
+        return self._height
+
+    def chunk_count(self) -> Int:
+        return len(self._chunks)
+
+    def width(self) -> Int:
+        return self._chunks[0].width()
+
+    def _chunk_index(self, row: Int) raises -> Int:
+        if row < 0 or row >= self._height:
+            raise Error("Row index out of bounds")
+        var low = 0
+        var high = len(self._ends)
+        while low < high:
+            var middle = low + (high - low) // 2
+            if row < self._ends[middle]:
+                high = middle
+            else:
+                low = middle + 1
+        return low
+
+    def row(self, index: Int) raises -> List[AnyValue]:
+        var chunk = self._chunk_index(index)
+        var start = 0 if chunk == 0 else self._ends[chunk - 1]
+        return self._chunks[chunk].row(index - start)
+
+    def item_at(self, row: Int, column: Int) raises -> AnyValue:
+        """One global cell by already-bound column position."""
+        if column < 0 or column >= self.width():
+            raise Error("Column index out of bounds")
+        var chunk = self._chunk_index(row)
+        var start = 0 if chunk == 0 else self._ends[chunk - 1]
+        return self._chunks[chunk]._columns[column].get(row - start)
+
+    def item(self, row: Int, column: String) raises -> AnyValue:
+        return self.item_at(row, self._chunks[0]._index(column))
+
+    def sum_float64_at(self, column: Int) raises -> AnyValue:
+        """Merge a Float64 column's contiguous chunk scans without rebinding.
+
+        Float addition is intentionally reassociated across chunks, matching
+        the documented reduction contract.
+        """
+        if column < 0 or column >= self.width():
+            raise Error("Column index out of bounds")
+        var state = FloatSumState()
+        for frame in self._chunks:
+            ref series = frame._columns[column]
+            if series.dtype() != DataType.FLOAT64:
+                raise Error("ChunkedFrame.sum_float64_at requires Float64")
+            ref values = series._data[Column[Float64]]
+            for i in range(len(values)):
+                if values._valid(i):
+                    state.add(values._get(i))
+        return AnyValue(state.total) if state.count > 0 else AnyValue.null(
+            DataType.FLOAT64
+        )
+
+    def sum(self, column: String) raises -> AnyValue:
+        """Chunk-aware Int64/Float64 sum with one schema lookup."""
+        var index = self._chunks[0]._index(column)
+        var dtype = self._chunks[0]._columns[index].dtype()
+        if dtype == DataType.FLOAT64:
+            return self.sum_float64_at(index)
+        if dtype == DataType.INT64:
+            var state = IntSumState()
+            for frame in self._chunks:
+                ref values = frame._columns[index]._data[Column[Int64]]
+                for i in range(len(values)):
+                    if values._valid(i):
+                        state.add(values._get(i))
+            return AnyValue(state.value()) if state.count > 0 else AnyValue.null(
+                DataType.INT64
+            )
+        raise Error("ChunkedFrame.sum prototype supports Int64 and Float64")
+
+    def rechunk(self) raises -> DataFrame:
+        """Materialize a regular contiguous frame through the existing path."""
+        return concat(self._chunks.copy())
