+def read_csv_chunked(path: String, schema: CsvSchema) raises -> ChunkedFrame:
+    """Experimental default-option CSV reader retaining decoded range frames.
+
+    This is intentionally a narrow benchmark API: it proves whether callers
+    can consume CSV ranges without structural column assembly. Unsupported
+    paths and serial reads return one ordinary frame chunk.
+    """
+    var options = _options(
+        ",", '"', "", 0, -1, List[String](), False, False, "utf8", 65536
+    )
+    var keep = _projection(schema, List[String]())
+    var mapping = _map_file(path)
+    if mapping.address != 0 and _parallel_is_safe(
+        options, worker_count(1 << 40)
+    ):
+        var span = mapping.span()
+        var workers = _csv_workers(len(span))
+        if workers > 1:
+            var chunks = _csv_chunks(len(span), len(keep), workers)
+            var frames = _read_mapped_produced_frames(
+                mapping^, schema, True, options, keep, workers, chunks
+            )
+            return ChunkedFrame(frames^)
+    var contiguous = read_csv(path, schema)
+    return ChunkedFrame([contiguous^])
+
