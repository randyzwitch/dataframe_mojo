+def _direct_float_sum(
+    mut reducer: Reducer, bound: BoundExpr, columns: List[Series],
+    node: Node, start: Int, end: Int, grouped: Bool,
+) raises -> Bool:
+    if (
+        grouped
+        or (node.op != SUM and node.op != MEAN)
+        or bound.expr._nodes[node.left].op != COL
+    ):
+        return False
+    ref series = columns[bound.sources[node.left]]
+    if series.dtype() != DataType.FLOAT64:
+        return False
+    ref column = series._data[Column[Float64]]
+    var values = column.unsafe_values()
+    var total = SIMD[DType.float64, 4](0)
+    var count = _count_set(column._bits[], column._offset + start, end - start)
+    var i = start
+    if count == end - start:
+        while i + 4 <= end:
+            total += values.unsafe_load[width=4](i)
+            i += 4
+    else:
+        var bits = column.unsafe_validity()
+        while i + 4 <= end:
+            var bit = column._offset + i
+            var mask = UInt16(bits.unsafe_load(bit // 8)) >> UInt16(bit % 8)
+            if bit % 8 > 4:
+                mask |= UInt16(bits.unsafe_load(bit // 8 + 1)) << UInt16(8 - bit % 8)
+            var valid = (SIMD[DType.uint64, 4](UInt64(mask), UInt64(mask), UInt64(mask), UInt64(mask)) & SIMD[DType.uint64, 4](1, 2, 4, 8)).ne(SIMD[DType.uint64, 4](0))
+            total += valid.select(values.unsafe_load[width=4](i), SIMD[DType.float64, 4](0))
+            i += 4
+    reducer.float_sums[0].total += total.reduce_add()
+    reducer.float_sums[0].count += Int64(count)
+    while i < end:
+        if column._valid(i):
+            reducer.float_sums[0].total += column._get(i)
+        i += 1
+    return True
+
