+def stream_csv_parallel_filter_select_sum(
+    path: String, schema: CsvSchema, *, window_bytes: Int = _PARALLEL_BLOCK
+) raises -> DataFrame:
+    """Experimental bounded parallel CSV pipeline for x>0, x*2, then sum.
+
+    A 32 MiB input window is split at safe CSV record boundaries. Dynamic
+    pool jobs decode one range and reduce it before releasing its frame, so
+    only one window and scalar partial sums remain live. This intentionally
+    covers the row-local-to-global-reduction shape of #109, not general lazy
+    plans or pipeline breakers.
+    """
+    if window_bytes < _MIN_CHUNK_BYTES:
+        raise Error("window_bytes is too small")
+    var options = _options(
+        ",", '"', "", 0, -1, List[String](), False, False, "utf8", 65536
+    )
+    var keep = _projection(schema, List[String]())
+    var quote = options.quote_char.as_bytes()[0]
+    var config = ArcPointer(_StreamingConfig(schema.copy(), options^, keep^))
+    var total = Float64(0)
+    var seen = False
+    var carry = List[UInt8]()
+    var first_window = True
+    var base = 0
+    var workers = _csv_workers(window_bytes)
+    var pool = Pool(workers)
+    with open(path, "r") as file:
+        while True:
+            var block = file.read_bytes(window_bytes)
+            var last = len(block) == 0
+            var buffer = carry^
+            carry = List[UInt8]()
+            buffer.extend(Span(block))
+            _ = block^
+            if len(buffer) == 0:
+                break
+            var chunks = _csv_chunks(len(buffer), len(config[].keep), workers)
+            var span = Span[UInt8, ImmutAnyOrigin](
+                unsafe_ptr=buffer.unsafe_ptr()
+                .unsafe_mut_cast[False]()
+                .unsafe_origin_cast[ImmutAnyOrigin](),
+                length=len(buffer),
+            )
+            var layout = record_splits(span, quote, True, chunks)
+            var upto = len(buffer) if last else layout.complete
+            if upto == 0:
+                carry = buffer^
+                if last:
+                    break
+                continue
+            if not last and upto < len(buffer):
+                carry.extend(Span(buffer)[upto:len(buffer)])
+            var shared = ArcPointer(buffer^)
+            var jobs = List[_StreamingRangeJob](capacity=len(layout.splits))
+            for split in range(len(layout.splits) - 1):
+                var start = layout.splits[split].offset
+                var end = min(layout.splits[split + 1].offset, upto)
+                if end <= start:
+                    continue
+                jobs.append(
+                    _StreamingRangeJob(
+                        config,
+                        shared,
+                        start,
+                        end,
+                        base + layout.splits[split].record,
+                        first_window and split == 0,
+                    )
+                )
+            if len(jobs) == 1:
+                jobs[0].run()
+            elif len(jobs) > 1:
+                pool.run(jobs, claim=True)
+            for i in range(len(jobs)):
+                if jobs[i].seen:
+                    total += jobs[i].total
+                    seen = True
+            base += layout.records
+            first_window = False
+            if last:
+                break
+    pool.release()
+    var values = List[Float64]([total])
+    var valid = List[Bool]([seen])
+    return DataFrame([Series("sum", Column[Float64](values^, valid))])
+
+
+def stream_csv_filter_select_sum(
+    path: String, schema: CsvSchema, *, batch_rows: Int = 8192
+) raises -> DataFrame:
+    """Experimental bounded CSV pipeline: filter x>0, select x*2 and y, sum.
+
+    This is deliberately not a general lazy executor. It demonstrates that a
+    stateful `_CsvReader` can transfer completed record batches to existing
+    eager row kernels and immediately merge a terminal aggregate, without
+    retaining source batches or rereading the file. The raw boundary scanner
+    handles quoted multiline records; the reader remains responsible for all
+    CSV validation and reports its original global record locations.
+    """
+    if batch_rows <= 0:
+        raise Error("batch_rows must be positive")
+    var options = _options(
+        ",", '"', "", 0, -1, List[String](), False, False, "utf8", 65536
+    )
+    var keep = _projection(schema, List[String]())
+    var reader = _CsvReader(schema, True, options, keep^)
+    var predicate = col("x") > lit(Float64(0))
+    var total = Float64(0)
+    var seen = False
+
+    @__parameter
+    def consume(var batch: DataFrame) raises:
+        if batch.height() == 0:
+            return
+        var selected = batch.filter(predicate.copy()).select_exprs(
+            [(col("x") * lit(Float64(2))).alias("double"), col("y")]
+        )
+        var part = selected.column("double").sum()
+        if not part.is_null():
+            total += part.float64()
+            seen = True
+
+    # This small structural scan decides only when it is safe to drain. It
+    # toggles twice for doubled quotes, carries quote parity across file reads,
+    # and never parses or validates fields; `_CsvReader` sees every byte in
+    # original order and remains the source of all errors.
+    var buffer = List[UInt8]()
+    var scan = 0
+    var records = 0
+    var inside = False
+    with open(path, "r") as file:
+        while True:
+            var block = file.read_bytes(65536)
+            var eof = len(block) == 0
+            buffer.extend(Span(block))
+            _ = block^
+            while scan < len(buffer):
+                var byte = buffer[scan]
+                scan += 1
+                if reader.quoting and byte == reader.quote:
+                    inside = not inside
+                elif byte == 10 and not inside:
+                    records += 1
+                    if records >= batch_rows:
+                        reader.feed(Span[UInt8, ImmutAnyOrigin](
+                            unsafe_ptr=buffer.unsafe_ptr()
+                            .unsafe_mut_cast[False]()
+                            .unsafe_origin_cast[ImmutAnyOrigin](),
+                            length=scan,
+                        ))
+                        consume(reader.drain())
+                        var tail = List[UInt8](capacity=len(buffer) - scan)
+                        tail.extend(Span[UInt8, ImmutAnyOrigin](
+                unsafe_ptr=buffer.unsafe_ptr()
+                .unsafe_mut_cast[False]()
+                .unsafe_origin_cast[ImmutAnyOrigin](),
+                length=len(buffer),
+            )[scan:len(buffer)])
+                        buffer = tail^
+                        scan = 0
+                        records = 0
+                        # Drains happen only on an outside newline.
+                        inside = False
+            if eof:
+                break
+    if len(buffer) > 0:
+        reader.feed(
+            Span[UInt8, ImmutAnyOrigin](
+                unsafe_ptr=buffer.unsafe_ptr()
+                .unsafe_mut_cast[False]()
+                .unsafe_origin_cast[ImmutAnyOrigin](),
+                length=len(buffer),
+            )
+        )
+    consume(reader.finish())
+    var values = List[Float64]([total])
+    var valid = List[Bool]([seen])
+    return DataFrame([Series("sum", Column[Float64](values^, valid))])
+
