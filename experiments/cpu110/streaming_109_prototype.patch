+@fieldwise_init
+struct _StreamingConfig(Movable):
+    var schema: CsvSchema
+    var options: CsvOptions
+    var keep: List[Bool]
+
+
+struct _StreamingRangeJob(Job):
+    """Decode one bounded window range and immediately reduce its rows."""
+
+    var config: ArcPointer[_StreamingConfig]
+    var bytes: ArcPointer[List[UInt8]]
+    var start: Int
+    var end: Int
+    var record: Int
+    var leading: Bool
+    var total: Float64
+    var seen: Bool
+
+    def __init__(
+        out self,
+        config: ArcPointer[_StreamingConfig],
+        bytes: ArcPointer[List[UInt8]],
+        start: Int,
+        end: Int,
+        record: Int,
+        leading: Bool,
+    ):
+        self.config = config.copy()
+        self.bytes = bytes.copy()
+        self.start = start
+        self.end = end
+        self.record = record
+        self.leading = leading
+        self.total = 0
+        self.seen = False
+
+    def run(mut self) raises:
+        ref config = self.config[]
+        var reader = _CsvReader(
+            config.schema, self.leading, config.options, config.keep
+        )
+        reader.record += self.record
+        if not self.leading:
+            reader.prefix_done = True
+        ref bytes = self.bytes[]
+        reader.feed(
+            Span[UInt8, ImmutAnyOrigin](
+                unsafe_ptr=bytes.unsafe_ptr()
+                .unsafe_mut_cast[False]()
+                .unsafe_origin_cast[ImmutAnyOrigin]()
+                .unsafe_offset(self.start),
+                length=self.end - self.start,
+            )
+        )
+        var input = reader.finish()
+        if input.height() == 0:
+            return
+        var selected = input.filter(col("x") > lit(Float64(0))).select_exprs(
+            [(col("x") * lit(Float64(2))).alias("double"), col("y")]
+        )
+        var part = selected.column("double").sum()
+        if not part.is_null():
+            self.total = part.float64()
+            self.seen = True
+
+
 struct _RangeJob(Job):
     """Decode one record-aligned byte range with a reader of its own."""
 
