+struct _TopKRangeJob(Job):
+    """Select one contiguous range; the final merge handles worker overlap."""
+
+    var ranks: ArcPointer[List[List[Int]]]
+    var start: Int
+    var end: Int
+    var k: Int
+    var rows: List[Int]
+
+    def __init__(
+        out self,
+        ranks: ArcPointer[List[List[Int]]],
+        start: Int,
+        end: Int,
+        k: Int,
+    ):
+        self.ranks = ranks.copy()
+        self.start = start
+        self.end = end
+        self.k = k
+        self.rows = List[Int]()
+
+    def run(mut self) raises:
+        self.rows = _partial_smallest(self.ranks[], self.start, self.end, self.k)
+
+
+def _parallel_smallest_indices(
+    ranks: List[List[Int]], k: Int, workers: Int
+) raises -> List[Int]:
+    """A stable global top-k from independently selected contiguous ranges."""
+    var n = len(ranks[0])
+    var shared = ArcPointer(ranks.copy())
+    var bounds = partitions(n, workers, 1)
+    var jobs = List[_TopKRangeJob](capacity=workers)
+    for worker in range(workers):
+        jobs.append(
+            _TopKRangeJob(shared, bounds[worker], bounds[worker + 1], k)
+        )
+    run_jobs(jobs)
+    var candidates = List[Int](capacity=k * workers)
+    for worker in range(workers):
+        for row in jobs[worker].rows:
+            candidates.append(row)
+    # A global top-k member must be among its own range's k stable best rows.
+    # This second heap is small (at most workers * k), then restores output
+    # order by the same rank-plus-row order as the serial implementation.
+    var best = List[Int](capacity=k)
+    for row in candidates:
+        if len(best) < k:
+            best.append(row)
+            var child = len(best) - 1
+            while child > 0:
+                var parent = (child - 1) // 2
+                if not _rank_less(ranks, best[parent], best[child]):
+                    break
+                var tmp = best[parent]
+                best[parent] = best[child]
+                best[child] = tmp
+                child = parent
+        elif _rank_less(ranks, row, best[0]):
+            best[0] = row
+            var parent = 0
+            while True:
+                var largest = parent
+                var left = 2 * parent + 1
+                var right = left + 1
+                if left < len(best) and _rank_less(ranks, best[largest], best[left]):
+                    largest = left
+                if right < len(best) and _rank_less(ranks, best[largest], best[right]):
+                    largest = right
+                if largest == parent:
+                    break
+                var tmp = best[parent]
+                best[parent] = best[largest]
+                best[largest] = tmp
+                parent = largest
+    return _order_smallest(ranks, best)
+
