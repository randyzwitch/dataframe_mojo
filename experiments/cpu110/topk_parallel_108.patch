+def _order_smallest(ranks: List[List[Int]], rows: List[Int]) raises -> List[Int]:
+    var selected = List[List[Int]]()
+    for key in ranks:
+        var subset = List[Int](capacity=len(rows))
+        for row in rows:
+            subset.append(key[row])
+        selected.append(subset^)
+    var positions = List[Int](capacity=len(rows))
+    for row in rows:
+        positions.append(row)
+    selected.append(positions^)
+    var order = sort_indices(selected)
+    var result = List[Int](capacity=len(rows))
+    for i in order:
+        result.append(rows[i])
+    return result^
+
